# Published API port on the Raspberry Pi. The container listens on 8000.
API_PORT=8000

# DB service on the shared Docker network, using its internal port.
# Use the connection details confirmed by the DB chat.
# URL-encode special characters in the username and password.
DATABASE_URL="postgresql://db_user:db_password@postgres:5432/changwon_dev"
# A separate database containing the DB repo's common development seed.
# Leave blank to skip database integration tests.
TEST_DATABASE_URL=

# Allowed frontend origins, separated by commas
CORS_ORIGINS=

# Session cookie name. Set the expiration policy during authentication setup.
SESSION_COOKIE_NAME=session
SESSION_TTL_SECONDS=

# Public data cache and API keys
CACHE_DIR=.cache
WEATHER_API_KEY=
WELFARE_API_KEY=
