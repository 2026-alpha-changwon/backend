# API port
API_PORT=8000

# Replace these example values with the connection details from the DB repo.
DATABASE_URL="postgresql://db_user:db_password@db_host:5432/db_name"
TEST_DATABASE_URL="postgresql://db_user:db_password@db_host:5432/test_db_name"

# Allowed frontend origins, separated by commas
CORS_ORIGINS=

# Session cookie name. Set the expiration policy during authentication setup.
SESSION_COOKIE_NAME=session
SESSION_TTL_SECONDS=

# Public data cache and API keys
CACHE_DIR=.cache
WEATHER_API_KEY=
WELFARE_API_KEY=
